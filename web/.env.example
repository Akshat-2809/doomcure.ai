# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables.

# Canonical site URL, used for metadata, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://doomcure.com

# Postgres connection string. On Vercel, adding Neon from the Marketplace
# sets this automatically. Use the pooled connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/doomcure

# Resend (https://resend.com). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Doomcure <support@doomcureai.com>"
# Where new waitlist signups are announced.
NOTIFY_EMAIL=support@doomcureai.com

# Random secret used to hash visitor IPs for rate limiting (e.g. `openssl rand -hex 32`).
IP_HASH_SALT=
