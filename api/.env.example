NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres (Neon via the Vercel Marketplace). Use the pooled URL here.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Optional: direct (non-pooled) URL, used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# Long random string. Visitor IPs are HMAC-hashed with it; raw IPs are never stored.
# Generate one with: openssl rand -hex 32
IP_HASH_SECRET=

# Resend (emails are skipped, with a warning in the logs, if this is empty)
RESEND_API_KEY=
EMAIL_FROM=Doomcure <hello@doomcure.com>
NOTIFY_EMAIL=

# Extra CORS origins, comma separated. doomcure.com and www.doomcure.com are always allowed;
# localhost is allowed when NODE_ENV is not production. `*` matches one subdomain label part.
ALLOWED_ORIGINS=https://doomcure-*.vercel.app

RATE_LIMIT_PER_HOUR=10
